<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Daqifi.Desktop.View.MigrationStatusWindow"
        Title="DAQiFi"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        CanResize="False"
        SizeToContent="WidthAndHeight"
        Background="{StaticResource Surface}"
        Topmost="True">
    <!-- Ported from Daqifi.Desktop/View/MigrationStatusWindow.xaml.
         WPF WindowStyle="None" + AllowsTransparency → SystemDecorations="None";
         ResizeMode="NoResize" → CanResize="False";
         RenderOptions.BitmapScalingMode → BitmapInterpolationMode;
         WPF pack-relative image path → avares:// URI. -->
    <Border Background="{StaticResource Surface}"
            BorderBrush="{StaticResource BorderDim}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="32,24">
        <StackPanel HorizontalAlignment="Center">
            <Image Source="avares://Daqifi.Avalonia/Daqifi.Desktop/Images/DAQiFi.png"
                   Width="200"
                   Margin="0,0,0,16"
                   RenderOptions.BitmapInterpolationMode="HighQuality" />
            <TextBlock Text="Upgrading database, please wait..."
                       FontSize="14"
                       Foreground="{StaticResource TextSecondary}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12" />
            <ProgressBar IsIndeterminate="True"
                         Height="4"
                         Width="200"
                         Foreground="{StaticResource Accent}" />
        </StackPanel>
    </Border>
</Window>
