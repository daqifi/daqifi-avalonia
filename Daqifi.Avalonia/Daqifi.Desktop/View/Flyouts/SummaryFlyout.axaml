<UserControl x:Class="Daqifi.Desktop.View.Flyouts.SummaryFlyout"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             Background="{DynamicResource SurfaceRaised}">

    <!--
        Pane content for the single SplitView flyout host in MainWindow
        (hal: flyout_host). MahApps Flyout chrome lives on the host.
        WPF GroupBox has no Avalonia counterpart — HeaderedContentControl
        with the groupBox theme below reproduces it.
    -->

    <UserControl.Resources>
        <ControlTheme x:Key="GroupBoxTheme" TargetType="HeaderedContentControl">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border BorderBrush="{DynamicResource BorderDim}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Margin="8">
                        <Grid RowDefinitions="Auto,*">
                            <!-- Filled accent header bar, matching the original MahApps
                                 GroupBox blue uppercase section headers (#6). -->
                            <Border Grid.Row="0"
                                    Background="{DynamicResource Accent}"
                                    CornerRadius="2,2,0,0"
                                    Padding="10,5">
                                <ContentPresenter Content="{TemplateBinding Header}"
                                                  TextElement.FontWeight="Bold"
                                                  TextElement.Foreground="White"/>
                            </Border>
                            <ContentPresenter Grid.Row="1"
                                              Content="{TemplateBinding Content}"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TextBlock.cell">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.cellHeader">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Header (MahApps Flyout rendered Header + close chrome) -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="20,12,12,4">
            <TextBlock Grid.Column="0" Text="Log Summary"
                       FontSize="18" FontWeight="Light"
                       Foreground="{DynamicResource TextPrimary}"
                       VerticalAlignment="Center"/>
            <ToggleButton Grid.Column="1"
                          i:Attached.Icon="mdi-close"
                          Background="Transparent" BorderThickness="0"
                          Foreground="{DynamicResource TextSecondary}"
                          Cursor="Hand"
                          ToolTip.Tip="Close"
                          IsChecked="{Binding IsLogSummaryOpen, Mode=TwoWay}"/>
        </Grid>

        <HeaderedContentControl Grid.Row="1" Header="SETTINGS" Theme="{StaticResource GroupBoxTheme}">
            <!--
                Two columns, both content-sized, because the flyout pane is a fixed 380px
                (MainWindow's SplitView OpenPaneLength) and the longest label here is wider
                than any number picked in advance: a pinned label column clipped it, and a
                pinned button column then squeezed the middle until the ToggleSwitch's
                "Stopped" ran under Reset. Reset is an action on the whole box rather than a
                third field, so it sits on its own row instead of competing for that width.
            -->
            <Grid Margin="15" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto"
                  ColumnSpacing="8" RowSpacing="8">
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="cellHeader" Text="Log Session"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Classes="cell"
                           Text="{Binding SelectedLoggingSession.Name}" TextAlignment="Center"/>

                <!-- Refresh cadence, not a window size: the measurement window itself runs until
                     Reset. Core's AcquisitionStatistics accumulates continuously, so this only
                     decides how often the figures below are re-read. -->
                <TextBlock Grid.Row="1" Grid.Column="0" Classes="cellHeader" Text="Refresh Every (msgs)"/>
                <NumericUpDown Grid.Row="1" Grid.Column="1"
                               Value="{Binding SummaryLogger.SampleSize}"
                               Minimum="1" Increment="1"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Classes="cellHeader" Text="Status"/>
                <ToggleSwitch Grid.Row="2" Grid.Column="1"
                              Command="{Binding SummaryLogger.ToggleEnabledCommand}"
                              IsChecked="{Binding SummaryLogger.Enabled, Mode=OneWay}"
                              OffContent="Stopped" OnContent="Running" HorizontalAlignment="Left"/>
                <Button Grid.Row="3" Grid.Column="1" Content="Reset" HorizontalAlignment="Right"
                        Command="{Binding SummaryLogger.ResetCommand}"/>
            </Grid>
        </HeaderedContentControl>

        <!--
            One section per reporting device. Core keys its per-channel accumulators by channel
            type and number, so each device gets its own aggregator and its own figures — nothing
            here merges statistics across devices, and two boards' channel 0 can no longer land in
            a single row.
        -->
        <ScrollViewer Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <ItemsControl ItemsSource="{Binding SummaryLogger.Devices}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
            <Grid RowDefinitions="Auto,Auto">

                <HeaderedContentControl Grid.Row="0" Header="{Binding Title}" Theme="{StaticResource GroupBoxTheme}">
                    <Grid Margin="5" ColumnDefinitions="150,*,*,*"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="cellHeader" Text="Updated"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Classes="cell"
                                   Text="{Binding LastUpdate, StringFormat=HH:mm:ss.fffffff}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="cellHeader" Text="Samples"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Classes="cell"
                                   Text="{Binding SampleCount}"/>

                        <!-- Total throughput, NOT the per-channel rate this row used to show.
                             The per-channel rate now has its own pair of columns below, measured
                             against both clocks, which is the number worth reading. -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="cellHeader" Text="Total Samples/s"
                                   ToolTip.Tip="Every channel of this device combined, measured against the host clock. Per-channel rates are in the CHANNELS section."/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Classes="cell"
                                   Text="{Binding SampleRate}" TextAlignment="Center"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Classes="cellHeader" Text="Statuses"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Classes="cell"
                                   Text="{Binding StatusList}" TextAlignment="Right"/>

                        <TextBlock Grid.Row="4" Grid.Column="1" Classes="cellHeader" Text="Min"/>
                        <TextBlock Grid.Row="4" Grid.Column="2" Classes="cellHeader" Text="Avg"/>
                        <TextBlock Grid.Row="4" Grid.Column="3" Classes="cellHeader" Text="Max"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Classes="cellHeader" Text="Latency (ms)"
                                   ToolTip.Tip="How far behind the device's own account of when a sample was taken the host was when it saw it. Negative means the device clock is running ahead of the host's."/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Classes="cell"
                                   Text="{Binding MinLatency}" TextAlignment="Right"/>
                        <TextBlock Grid.Row="5" Grid.Column="2" Classes="cell"
                                   Text="{Binding AverageLatency}" TextAlignment="Right"/>
                        <TextBlock Grid.Row="5" Grid.Column="3" Classes="cell"
                                   Text="{Binding MaxLatency}" TextAlignment="Right"/>
                    </Grid>
                </HeaderedContentControl>

                <HeaderedContentControl Grid.Row="1" Header="CHANNELS" Theme="{StaticResource GroupBoxTheme}">
                    <ItemsControl ItemsSource="{Binding Channels}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="5" ColumnDefinitions="150,*,*,*"
                                      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                                    <!-- No per-channel "last update" column: the device stamps every
                                         channel in a frame with the same time, so all sixteen read
                                         identically and duplicate the device's own Updated row. -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="cell"
                                               Text="{Binding Name}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Classes="cell"
                                               Text="Count" TextAlignment="Right"/>
                                    <TextBlock Grid.Row="0" Grid.Column="3" Classes="cell"
                                               Text="{Binding SampleCount}" TextAlignment="Right"/>

                                    <!-- The two rates side by side are the point of the panel: both
                                         low means samples went missing, a disagreement means the
                                         device and host clocks have drifted apart. -->
                                    <TextBlock Grid.Row="1" Grid.Column="2" Classes="cellHeader"
                                               Text="Host clock" TextAlignment="Right"/>
                                    <TextBlock Grid.Row="1" Grid.Column="3" Classes="cellHeader"
                                               Text="Device clock" TextAlignment="Right"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="cellHeader" Text="Sample Rate (Hz)"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Classes="cell"
                                               Text="{Binding SampleRate}" TextAlignment="Right"/>
                                    <TextBlock Grid.Row="2" Grid.Column="3" Classes="cell"
                                               Text="{Binding DeviceClockSampleRate}" TextAlignment="Right"/>

                                    <TextBlock Grid.Row="3" Grid.Column="1" Classes="cellHeader" Text="Min" TextAlignment="Right"/>
                                    <TextBlock Grid.Row="3" Grid.Column="2" Classes="cellHeader" Text="Avg" TextAlignment="Right"/>
                                    <TextBlock Grid.Row="3" Grid.Column="3" Classes="cellHeader" Text="Max" TextAlignment="Right"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Classes="cellHeader" Text="Interval (ms)"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Classes="cell"
                                               Text="{Binding MinDelta}" TextAlignment="Right"/>
                                    <TextBlock Grid.Row="4" Grid.Column="2" Classes="cell"
                                               Text="{Binding AverageDelta}" TextAlignment="Right"/>
                                    <TextBlock Grid.Row="4" Grid.Column="3" Classes="cell"
                                               Text="{Binding MaxDelta}" TextAlignment="Right"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Classes="cellHeader" Text="Value"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Classes="cell"
                                               Text="{Binding MinValue}" TextAlignment="Right"/>
                                    <TextBlock Grid.Row="5" Grid.Column="2" Classes="cell"
                                               Text="{Binding AverageValue}" TextAlignment="Right"/>
                                    <TextBlock Grid.Row="5" Grid.Column="3" Classes="cell"
                                               Text="{Binding MaxValue}" TextAlignment="Right"/>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Classes="cellHeader" Text="Out of order"
                                               ToolTip.Tip="Samples that arrived stamped behind one already seen on this channel."/>
                                    <TextBlock Grid.Row="6" Grid.Column="3" Classes="cell"
                                               Text="{Binding OutOfOrderSampleCount}" TextAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </HeaderedContentControl>
            </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
