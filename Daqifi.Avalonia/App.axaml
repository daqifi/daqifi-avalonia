<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="using:Daqifi.Desktop.Helpers"
             xmlns:converters="using:Daqifi.Desktop.Converters"
             x:Class="Daqifi.Avalonia.App"
             Name="DAQiFi"
             RequestedThemeVariant="Dark">
    <!-- Name is what macOS shows in the menu bar, the Dock and Force Quit, and it is NOT
         read from the bundle's Info.plist: Avalonia's macOS backend pushes Application.Name
         into NSApplication at startup, so it wins over CFBundleName. Unset, it defaults to
         the framework's "Avalonia Application" — measured, not assumed: with a correct
         Info.plist but no Name, `lsappinfo` still reported the app as
         "Avalonia Application" (#108). Harmless on the other heads, where the visible name
         comes from the manifest / plist instead. -->
    <Application.Styles>
        <FluentTheme />
        <!-- Avalonia's DataGrid ships its theme in its own package (DebugWindow) -->
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
        <!-- OxyPlot control templates: PlotView renders into its template's PART_Panel,
             and OnApplyTemplate silently no-ops without one — omitting this include
             produces a fully blank (not crashed) plot. First streaming QA 2026-07-13:
             data decoded + persisted + InvalidatePlot ticking, zero pixels drawn. -->
        <StyleInclude Source="avares://OxyPlot.Avalonia/Themes/Default.axaml"/>
        <!-- Shared component styles (chips, section headers, list rows, empty-state,
             mono) so the mobile panes match the desktop design language. -->
        <StyleInclude Source="avares://Daqifi.Avalonia/Daqifi.Desktop/Resources/Components.axaml"/>
    </Application.Styles>
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Canonical design tokens (hal: theming_tokens) — MahApps theme
                     dictionaries are replaced by FluentTheme + ThemeVariant. -->
                <ResourceInclude Source="avares://Daqifi.Avalonia/Daqifi.Desktop/Resources/DesignTokens.axaml"/>
                <!-- Dark dialog control themes (upstream merges DarkDialog.xaml per-window;
                     everything here is keyed/opt-in, so an app-level merge is safe and
                     avoids repeating the include in every dialog). -->
                <ResourceInclude Source="avares://Daqifi.Avalonia/Daqifi.Desktop/Resources/DarkDialog.axaml"/>
                <!-- Shared shell chrome (nav rail + segmented toggle) — the desktop
                     MainWindow and the mobile landscape shell render the same rail. -->
                <ResourceInclude Source="avares://Daqifi.Avalonia/Daqifi.Desktop/Resources/Shell.axaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Upstream App.xaml converter registrations, same keys. The WPF-framework
                 BoolToVis / InvertedBoolToVis registrations are dropped — Avalonia binds
                 IsVisible directly (with ! for negation). The ported Converters return
                 bool for the visibility-flavored keys, so they too target IsVisible. -->
            <helpers:IntToVisibilityConverter x:Key="IntToVisibility"/>
            <converters:BoolAndToVisibilityConverter x:Key="BoolAndToVis"/>
            <helpers:EnumDescriptionConverter x:Key="EnumDescription"/>
            <helpers:BooleanToInverseBoolConverter x:Key="BooleanToInverse"/>
            <converters:BoolToActiveStatusConverter x:Key="BoolToActiveStatus"/>
            <converters:BoolToStatusColorConverter x:Key="BoolToStatusColor"/>
            <converters:ListToStringConverter x:Key="ListToStringConverter"/>
            <converters:BrushColorMatchConverter x:Key="BrushColorMatch"/>
            <converters:OxyColorToBrushConverter x:Key="OxyColorToBrushConverter"/>
            <converters:NotNullToVisibilityConverter x:Key="NotNullToVis"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
