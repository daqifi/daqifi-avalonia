<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Daqifi.Avalonia.Views"
             x:Class="Daqifi.Avalonia.Views.MobileShellView"
             x:DataType="views:MobileShellViewModel">
	<!-- Mobile shell (#221 five-platform goal): WiFi discovery + connect on
	     the SAME ported stack the desktop uses. WiFi/TCP only (DIV-UI-003).
	     Styled with the shared DesignTokens + FluentTheme (App.axaml) so it
	     matches the desktop app and the projected panes — no bespoke palette. -->
	<Border Background="{DynamicResource Surface}" Padding="20,48,20,24">
		<DockPanel>
			<StackPanel DockPanel.Dock="Top" Spacing="6">
				<TextBlock Text="DAQiFi"
				           FontSize="{DynamicResource FontSizeDisplay}" FontWeight="Bold"
				           Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" />
				<TextBlock x:Name="VersionText"
				           FontSize="{DynamicResource FontSizeCaption}"
				           Foreground="{DynamicResource TextTertiary}"
				           HorizontalAlignment="Center" />
			</StackPanel>

			<Button DockPanel.Dock="Top"
			        Command="{Binding ScanCommand}"
			        IsVisible="{Binding !IsStreaming}"
			        HorizontalAlignment="Stretch"
			        HorizontalContentAlignment="Center"
			        Margin="0,20,0,10" Padding="0,14"
			        FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="SemiBold"
			        Foreground="White" Background="{DynamicResource Accent}"
			        CornerRadius="10">
				<Panel>
					<TextBlock Text="Scan for devices" IsVisible="{Binding !IsScanning}" />
					<TextBlock Text="Stop scanning" IsVisible="{Binding IsScanning}" />
				</Panel>
			</Button>

			<!-- Stream toggle appears once a device is connected -->
			<Button DockPanel.Dock="Top"
			        Command="{Binding StreamToggleCommand}"
			        IsVisible="{Binding IsConnected}"
			        HorizontalAlignment="Stretch"
			        HorizontalContentAlignment="Center"
			        Margin="0,0,0,10" Padding="0,14"
			        FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="SemiBold"
			        Foreground="White" Background="{DynamicResource Accent}"
			        CornerRadius="10">
				<Panel>
					<TextBlock Text="Start streaming" IsVisible="{Binding !IsStreaming}" />
					<TextBlock Text="Stop streaming" IsVisible="{Binding IsStreaming}" />
				</Panel>
			</Button>

			<!-- Channel + sample-rate picker: shown once connected, before streaming -->
			<Border DockPanel.Dock="Top" IsVisible="{Binding ShowChannelSelector}"
			        Background="{DynamicResource SurfaceRaised}"
			        BorderBrush="{DynamicResource BorderDim}" BorderThickness="1"
			        CornerRadius="12" Padding="14,12" Margin="0,0,0,10">
				<StackPanel Spacing="10">
					<Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center">
						<TextBlock Grid.Column="0" Text="Rate (Hz):"
						           VerticalAlignment="Center" FontSize="{DynamicResource FontSizeBody}"
						           Foreground="{DynamicResource TextSecondary}" Margin="0,0,10,0" />
						<ComboBox Grid.Column="1" MinWidth="90" HorizontalAlignment="Left"
						          ItemsSource="{Binding AvailableRates}"
						          SelectedItem="{Binding SampleRate}" />
						<Button Grid.Column="2" Content="All" Theme="{StaticResource AccentPillButton}"
						        Command="{Binding SelectAllChannelsCommand}" Margin="0,0,6,0" />
						<Button Grid.Column="3" Content="None" Theme="{StaticResource PillButton}"
						        Command="{Binding SelectNoChannelsCommand}" />
					</Grid>
					<TextBlock Text="Channels to stream:" FontSize="{DynamicResource FontSizeCaption}"
					           Foreground="{DynamicResource TextTertiary}" />
					<ScrollViewer MaxHeight="360">
						<ItemsControl ItemsSource="{Binding Channels}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<UniformGrid Columns="2" />
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="views:ChannelToggle">
									<CheckBox IsChecked="{Binding IsSelected}"
									          Content="{Binding Name}"
									          Foreground="{DynamicResource TextPrimary}"
									          FontSize="{DynamicResource FontSizeBody}"
									          Margin="0,2" />
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>
				</StackPanel>
			</Border>

			<!-- Live plot fills the middle while streaming -->
			<views:LivePlot x:Name="Plot" DockPanel.Dock="Top"
			                IsVisible="{Binding IsStreaming}"
			                Height="360" Margin="0,0,0,10" />

			<StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
				<TextBlock Text="{Binding Status}"
				           TextWrapping="Wrap"
				           FontSize="{DynamicResource FontSizeLabel}"
				           Foreground="{DynamicResource TextSecondary}" />
				<!-- Manual IP: AP client-isolation drops broadcast discovery
				     on many networks; connect directly like the desktop app. -->
				<TextBlock Text="Or connect by IP (data port 9760):"
				           FontSize="{DynamicResource FontSizeSmall}"
				           Foreground="{DynamicResource TextTertiary}" />
				<Grid ColumnDefinitions="*,90,Auto" ColumnSpacing="8">
					<TextBox Grid.Column="0" Text="{Binding ManualIp}"
					         Watermark="192.168.1.234" FontSize="{DynamicResource FontSizeBody}" />
					<TextBox Grid.Column="1" Text="{Binding ManualPort}"
					         FontSize="{DynamicResource FontSizeBody}" />
					<Button Grid.Column="2" Content="Connect" Theme="{StaticResource AccentPillButton}"
					        Command="{Binding ManualConnectCommand}" />
				</Grid>

				<!-- Experimental USB (OTG) connect — shown only on Android (a
				     USB-host connector is registered). Connects the attached DAQiFi
				     over USB-CDC and registers it, lighting up SD offload in the
				     Storage tab. StatusAmber signals the experimental path.
				     See docs/mobile-usb-feasibility.md. -->
				<Button Content="Connect via USB (OTG)"
				        Command="{Binding ConnectUsbCommand}"
				        IsVisible="{Binding IsUsbAvailable}"
				        HorizontalAlignment="Stretch"
				        HorizontalContentAlignment="Center"
				        Margin="0,2,0,0" Padding="0,12"
				        FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold"
				        Foreground="{DynamicResource Surface}"
				        Background="{DynamicResource StatusAmber}" CornerRadius="8" />
			</StackPanel>

			<ScrollViewer IsVisible="{Binding ShowDeviceList}">
				<ItemsControl ItemsSource="{Binding Devices}">
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="views:MobileDeviceItem">
							<Button Command="{Binding ConnectCommand}"
							        HorizontalAlignment="Stretch"
							        HorizontalContentAlignment="Stretch"
							        Margin="0,6" Padding="16,12"
							        Background="{DynamicResource SurfaceRaised}"
							        BorderBrush="{DynamicResource BorderDim}" BorderThickness="1"
							        CornerRadius="12">
								<StackPanel Spacing="4">
									<TextBlock Text="{Binding Name}"
									           FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="SemiBold"
									           Foreground="{DynamicResource TextPrimary}" />
									<TextBlock Text="{Binding Detail}"
									           FontSize="{DynamicResource FontSizeCaption}"
									           Foreground="{DynamicResource TextTertiary}" />
								</StackPanel>
							</Button>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</ScrollViewer>
		</DockPanel>
	</Border>
</UserControl>
