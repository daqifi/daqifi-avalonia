<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             xmlns:v="clr-namespace:Daqifi.Avalonia.Views"
             x:Class="Daqifi.Avalonia.Views.MobileMainView">
  <!-- Orientation-adaptive shell (#221): LANDSCAPE renders the desktop's left
       nav rail + content (~1:1 with the desktop app); PORTRAIT falls back to the
       bottom-nav single-column. The content area is SHARED (col 1, row 0) between
       both — only the nav chrome swaps by orientation (code-behind toggles the
       rail vs the bottom bar). Rail styling mirrors the shared NavTabItem theme. -->
  <UserControl.Styles>
    <!-- Portrait bottom-nav button -->
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="MinHeight" Value="54" />
      <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.nav.active">
      <Setter Property="Foreground" Value="{DynamicResource Accent}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Landscape left-rail item — matches the desktop NavTabItem (3px accent
         stripe on select, SurfaceRaised bg, icon + caption). -->
    <Style Selector="Button.rail">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="Width" Value="88" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid ColumnDefinitions="3,*" Background="{TemplateBinding Background}">
            <Rectangle x:Name="Stripe" Grid.Column="0" Fill="{DynamicResource Accent}" Opacity="0" />
            <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="0,16" />
          </Grid>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.rail:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="Button.rail.active">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="Button.rail.active /template/ Rectangle#Stripe">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.rail TextBlock.railLabel">
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}" />
      <Setter Property="Margin" Value="0,6,0,0" />
    </Style>

    <!-- Top command-bar button (flat, matches the desktop windowCommand) -->
    <Style Selector="Button.topCommand">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.topCommand:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,*,Auto" Background="{DynamicResource Surface}">

    <!-- Top command bar (desktop chrome parity) — thin bar with right-aligned
         notifications + settings + help. Notifications mirrors the desktop bell +
         flyout; settings mirrors the desktop settings drawer (CSV delimiter). debug
         stays desktop-only. The bar's DataContext is the notifications VM (set in
         code-behind) so the bell badge binds to its live count (#11). -->
    <Border Grid.Row="0" Grid.ColumnSpan="2"
            Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource BorderDim}" BorderThickness="0,0,0,1">
      <StackPanel x:Name="TopCommandBar" Orientation="Horizontal"
                  HorizontalAlignment="Right" Margin="0,4">
        <Button Classes="topCommand" Click="OnNotifications" ToolTip.Tip="Notifications">
          <Panel>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <i:Icon Value="mdi-bell-outline" FontSize="18" VerticalAlignment="Center" />
              <TextBlock Text="notifications" VerticalAlignment="Center" />
            </StackPanel>
            <!-- Unread-count badge, mirrors the desktop bell badge (StatusRed); hidden at 0 -->
            <Border IsVisible="{Binding HasNotifications}"
                    Background="{DynamicResource StatusRed}" CornerRadius="7.5"
                    MinWidth="15" Height="15" Padding="3,0"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0">
              <TextBlock Text="{Binding NotificationCount}" FontSize="9" FontWeight="Bold"
                         Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </Panel>
        </Button>
        <Button Classes="topCommand" Click="OnSettings">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <i:Icon Value="mdi-cog" FontSize="18" VerticalAlignment="Center" />
            <TextBlock Text="settings" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Classes="topCommand" Click="OnHelp">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <i:Icon Value="mdi-help-circle-outline" FontSize="18" VerticalAlignment="Center" />
            <TextBlock Text="help" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Border>

    <!-- Left nav rail — LANDSCAPE only -->
    <Border x:Name="SideNav" Grid.Column="0" Grid.Row="1" Grid.RowSpan="2" IsVisible="False"
            Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource BorderDim}" BorderThickness="0,0,1,0">
      <StackPanel>
        <Button x:Name="RailStream" Classes="rail" Click="OnStream">
          <StackPanel>
            <i:Icon Value="mdi-chart-timeline-variant" FontSize="24" HorizontalAlignment="Center" />
            <TextBlock Classes="railLabel" Text="Live Graph" />
          </StackPanel>
        </Button>
        <Button x:Name="RailStorage" Classes="rail" Click="OnStorage">
          <StackPanel>
            <i:Icon Value="mdi-database-outline" FontSize="24" HorizontalAlignment="Center" />
            <TextBlock Classes="railLabel" Text="Logged Data" />
          </StackPanel>
        </Button>
        <Button x:Name="RailChannels" Classes="rail" Click="OnChannels">
          <StackPanel>
            <i:Icon Value="mdi-hub-outline" FontSize="24" HorizontalAlignment="Center" />
            <TextBlock Classes="railLabel" Text="Channels" />
          </StackPanel>
        </Button>
        <Button x:Name="RailProfiles" Classes="rail" Click="OnProfiles">
          <StackPanel>
            <i:Icon Value="mdi-tune-variant" FontSize="24" HorizontalAlignment="Center" />
            <TextBlock Classes="railLabel" Text="Profiles" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Border>

    <!-- Shared content area -->
    <Panel Grid.Column="1" Grid.Row="1">
      <v:MobileShellView x:Name="StreamView" />
      <ContentControl x:Name="SecondaryHost" IsVisible="False" />
    </Panel>

    <!-- Bottom nav — PORTRAIT only -->
    <Border x:Name="BottomNav" Grid.Column="1" Grid.Row="2"
            Background="{DynamicResource SurfaceRaised}"
            BorderBrush="{DynamicResource BorderDim}" BorderThickness="0,1,0,0">
      <UniformGrid Columns="4">
        <Button x:Name="NavStream"   Classes="nav" Content="Live Graph"  Click="OnStream" />
        <Button x:Name="NavStorage"  Classes="nav" Content="Logged Data" Click="OnStorage" />
        <Button x:Name="NavChannels" Classes="nav" Content="Channels" Click="OnChannels" />
        <Button x:Name="NavProfiles" Classes="nav" Content="Profiles" Click="OnProfiles" />
      </UniformGrid>
    </Border>

    <!-- Settings overlay (#11) — mirrors the desktop settings drawer's EXPORT /
         CSV DELIMITER preference. Right-anchored drawer over a scrim; hidden
         until the top-bar gear opens it. -->
    <Grid x:Name="SettingsOverlay" Grid.ColumnSpan="2" Grid.RowSpan="3"
          IsVisible="False" ZIndex="30">
      <Button Background="{DynamicResource Scrim}" HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch" BorderThickness="0" Click="OnCloseSettings" />
      <Border HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="320"
              Background="{DynamicResource SurfaceRaised}"
              BorderBrush="{DynamicResource BorderDim}" BorderThickness="1,0,0,0">
        <StackPanel Margin="24,28,24,24" Spacing="0">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0">
              <TextBlock Text="PREFERENCES" FontSize="9" FontWeight="Bold"
                         Foreground="{DynamicResource TextTertiary}" />
              <TextBlock Text="Settings" FontSize="22" FontWeight="Light"
                         Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="&#xD7;" FontSize="18"
                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                    Foreground="{DynamicResource TextSecondary}" Click="OnCloseSettings" />
          </Grid>

          <TextBlock Text="EXPORT" Classes="sectionLabel" Margin="0,22,0,10" />
          <Rectangle Height="1" Fill="{DynamicResource BorderDim}" Margin="0,0,0,16" />

          <TextBlock Text="CSV DELIMITER" FontSize="11" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextSecondary}" />
          <TextBlock Text="Separates columns when exporting logged sessions to CSV."
                     FontSize="11" Foreground="{DynamicResource TextTertiary}"
                     TextWrapping="Wrap" Margin="0,4,0,10" />
          <Border Background="{DynamicResource Surface}"
                  BorderBrush="{DynamicResource BorderDim}" BorderThickness="1"
                  CornerRadius="3" Padding="3" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
              <RadioButton GroupName="MobileCsvDelimiter" Content="COMMA  ,"
                           IsChecked="{Binding IsCommaDelimiter, Mode=TwoWay}"
                           Theme="{StaticResource SegmentedToggle}" />
              <RadioButton GroupName="MobileCsvDelimiter" Content="SEMICOLON  ;"
                           IsChecked="{Binding IsSemicolonDelimiter, Mode=TwoWay}"
                           Theme="{StaticResource SegmentedToggle}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Notifications overlay (#11) — the phone analog of the desktop bell's flyout: a
         right drawer over a scrim listing device/update notifications, or an empty state.
         Opened by the top-bar bell; its DataContext (the notifications VM) is shared with
         the bell badge and set once in code-behind. Starts empty — the desktop notification
         producers (firmware coordinator / DaqifiViewModel) don't run on mobile, so a mobile
         source is a follow-up; the VM's producer API is ready for it. -->
    <Grid x:Name="NotificationsOverlay" Grid.ColumnSpan="2" Grid.RowSpan="3"
          IsVisible="False" ZIndex="30">
      <Button Background="{DynamicResource Scrim}" HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch" BorderThickness="0" Click="OnCloseNotifications" />
      <Border HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="320"
              Background="{DynamicResource SurfaceRaised}"
              BorderBrush="{DynamicResource BorderDim}" BorderThickness="1,0,0,0">
        <Grid Margin="24,28,24,24" RowDefinitions="Auto,Auto,*">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0">
              <TextBlock Text="ALERTS" FontSize="9" FontWeight="Bold"
                         Foreground="{DynamicResource TextTertiary}" />
              <TextBlock Text="Notifications" FontSize="22" FontWeight="Light"
                         Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="&#xD7;" FontSize="18"
                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                    Foreground="{DynamicResource TextSecondary}" Click="OnCloseNotifications" />
          </Grid>

          <Rectangle Grid.Row="1" Height="1" Fill="{DynamicResource BorderDim}" Margin="0,18,0,0" />

          <!-- Empty state -->
          <StackPanel Grid.Row="2" IsVisible="{Binding HasNoNotifications}" Spacing="10"
                      VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,40">
            <i:Icon Value="mdi-bell-check-outline" FontSize="34" HorizontalAlignment="Center"
                    Foreground="{DynamicResource TextTertiary}" />
            <TextBlock Text="You're all caught up" HorizontalAlignment="Center" FontSize="14"
                       FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
            <TextBlock Text="Device and firmware alerts will appear here."
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                       MaxWidth="240" FontSize="11" Foreground="{DynamicResource TextTertiary}" />
          </StackPanel>

          <!-- Notification list -->
          <ScrollViewer Grid.Row="2" IsVisible="{Binding HasNotifications}" Margin="0,16,0,0">
            <ItemsControl ItemsSource="{Binding NotificationList}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{DynamicResource Surface}"
                          BorderBrush="{DynamicResource BorderDim}" BorderThickness="1"
                          CornerRadius="4" Padding="12" Margin="0,0,0,10">
                    <StackPanel Spacing="8">
                      <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                                 FontSize="12" Foreground="{DynamicResource TextPrimary}" />
                      <!-- Optional link (e.g. a firmware "learn more"), mirrors the desktop flyout;
                           hidden when the notification has no link. -->
                      <Button Content="Learn more" Click="OnNotificationLink" Tag="{Binding Link}"
                              IsVisible="{Binding Link, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                              Background="Transparent" BorderThickness="0" Padding="0"
                              Foreground="{DynamicResource Accent}" Cursor="Hand"
                              HorizontalAlignment="Left" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
