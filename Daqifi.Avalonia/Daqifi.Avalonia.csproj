<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!-- Platform-neutral shared library. The per-platform heads
		     (Daqifi.Avalonia.Desktop, Daqifi.Avalonia.Android, iOS later)
		     each reference this project and own their entry point + windowing
		     platform. Desktop-only concerns (WinExe output, app.manifest, the
		     Avalonia.Desktop startup package) live in the Desktop head. -->
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<!-- From Directory.Build.props, the single place the app's version is declared. This
		     assembly is the one every head links in, so it is what Daqifi.Desktop.Common.AppVersion
		     reads for the in-app version text and the Sentry release (#126). -->
		<Version>$(DaqifiAppVersion)</Version>
		<!-- Sentry DSN, baked into the shared assembly so every head reports crashes without
		     shipping a config file (Android cannot have an App.config at all, which is why
		     the upstream ConfigurationManager lookup left Sentry inert on every head here).

		     A DSN is not a secret: it is an ingest endpoint, embedded in every shipped client
		     and extractable from any binary, which is why the Windows app likewise commits its
		     own DSN in Daqifi.Desktop/App.config. It grants no read access to Sentry data —
		     the only abuse is sending junk events, which Sentry's rate limits and inbound
		     filters handle.

		     A DIFFERENT Sentry project from the WPF app, deliberately — same org
		     (o4511134234640384), separate project. The two shared one project until now, and
		     nothing separated the events once they arrived: neither app sets Environment, both
		     emit the same daqifi.* tag keys, both are on 3.3.0, and this port keeps upstream's
		     Daqifi.Desktop.* namespaces, so stack frames from the two look alike and Sentry's
		     grouping could fold a WPF issue and an Avalonia issue into one. Separate projects
		     also separate quota, alert rules and release timelines.

		     Override with -p:SentryDsn=<other> to point a build at a different project, or
		     -p:SentryDsn= to build with reporting disabled. -->
		<SentryDsn Condition="'$(SentryDsn)' == ''">https://aa43d7ab9071a9b60300a32b0acd07c2@o4511134234640384.ingest.us.sentry.io/4512011823218689</SentryDsn>
		<!-- LibraryImport (keep_awake Windows backend) generates unsafe marshalling stubs -->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
		<!-- Restore-graph breadth only (NETSDK1047): the Android head consumes
		     this project per-RID, so its RIDs must exist in our assets targets.
		     The Desktop head's publish targets pass -r explicitly. -->
		<RuntimeIdentifiers>win-x64;linux-x64;osx-x64;osx-arm64;android-arm64;android-x64</RuntimeIdentifiers>
	</PropertyGroup>

	<ItemGroup>
		<!-- The test project reaches one internal member: LoggingManager's test-only constructor,
		     which takes the context factory instead of resolving it from App.ServiceProvider (there
		     is no App in a test process). Upstream does the same thing for the same reason. This is
		     the only assembly that can see internals here, and it is never shipped. -->
		<InternalsVisibleTo Include="Daqifi.Avalonia.Tests" />
	</ItemGroup>

	<ItemGroup>
		<!-- Upstream ships images as WPF Resource; Avalonia loads them via avares:// URIs -->
		<AvaloniaResource Include="Daqifi.Desktop\Images\**" />
	</ItemGroup>

	<ItemGroup>
		<!-- Mirrors upstream Daqifi.Desktop.csproj's Compile Remove list — legacy files kept in-tree but never compiled -->
		<Compile Remove="Daqifi.Desktop\ViewModels\PlottingViewModel.cs" />
		<Compile Remove="Daqifi.Desktop\ViewModels\PlotViewModel.cs" />
		<Compile Remove="Daqifi.Desktop\ViewModels\ViewModelLocator.cs" />
	</ItemGroup>

	<ItemGroup>
		<!-- Avalonia stack (replaces WPF + MahApps.Metro per the UI catalog decision log).
		     Avalonia.Desktop (desktop windowing/startup) lives in the Desktop head, not here —
		     this library is platform-neutral and shared with the Android/iOS heads. -->
		<PackageReference Include="Avalonia" Version="12.1.1" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
		<!-- WPF DataGrid ships in-box; Avalonia's lives in a separate package (DebugWindow) -->
		<PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.0" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
		<!-- OxyPlot.Avalonia replaces OxyPlot.Wpf; the PlotModel layer (OxyPlot.Core) ports verbatim.
		     VENDORED as a ProjectReference: the NuGet 2.1.0 release targets Avalonia 0.10 and
		     crashes at runtime under Avalonia 11 — see third_party/oxyplot-avalonia/VENDORED.md -->
		<PackageReference Include="OxyPlot.Core" Version="2.2.0" />
		<!-- Same Material glyph set as MahApps.Metro.IconPacks.Material -->
		<PackageReference Include="Optris.Icons.Avalonia.MaterialDesign" Version="12.0.7" />
		<!-- Direct port of Microsoft.Xaml.Behaviors.Wpf -->
		<PackageReference Include="Xaml.Behaviors.Avalonia" Version="12.0.5" />

		<!-- Platform-neutral stack carried over from upstream Daqifi.Desktop + Daqifi.Desktop.Common -->
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Daqifi.Core" Version="1.7.0" />
		<PackageReference Include="EFCore.BulkExtensions.Sqlite" Version="10.0.1" />
		<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.10">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
		<PackageReference Include="NCalcSync" Version="6.4.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="NLog" Version="6.1.4" />
		<PackageReference Include="Sentry" Version="6.8.0" />
		<!-- AppLogger reads this back via AssemblyMetadata at startup (see ResolveSentryDsn).
		     Overridable per build: -p:SentryDsn= disables reporting entirely, and either an
		     App.config entry or DAQIFI_SENTRY_DSN takes precedence at run time. -->
		<AssemblyMetadata Include="SentryDsn" Value="$(SentryDsn)" Condition="'$(SentryDsn)' != ''" />
		<!-- All-platform native SQLite bundle (upstream committed a win-x64 e_sqlite3.dll) -->
		<PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.4" />
		<PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.10" />
		<!-- Desktop-only transports: serial + WMI hotplug (mobile is WiFi/TCP only, DIV-UI-003) -->
		<PackageReference Include="System.IO.Ports" Version="10.0.11" />
		<PackageReference Include="System.Management" Version="10.0.11" />
	</ItemGroup>

	<ItemGroup>
		<!-- Official OxyPlot.Avalonia source pinned at 9913a97 (Avalonia 11) — VENDORED.md -->
		<ProjectReference Include="..\third_party\oxyplot-avalonia\OxyPlot.Avalonia\OxyPlot.Avalonia.csproj" />
	</ItemGroup>
</Project>
