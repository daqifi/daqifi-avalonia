<Project>
    <!-- Upstream reads these from Source/Directory.Build.props (Avalonia 11.0.0 /
         OxyPlot.Core 2.1.2), which is outside the vendored subtree. Pin to the
         app's versions instead — see VENDORED.md. -->
    <PropertyGroup>
        <!-- Set here as well as in the repo-root Directory.Build.props: MSBuild stops at the first
             Directory.Build.props it finds walking up, so this subtree does NOT inherit the root
             one. Keep the two in step. -->
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <!-- Must mirror the root file's locked-mode arm too: generation alone lets a drifted
             restore silently regenerate the lock file instead of failing. -->
        <RestoreLockedMode Condition="'$(ContinuousIntegrationBuild)' == 'true' Or '$(CI)' == 'true'">true</RestoreLockedMode>
        <AvaloniaVersion>12.0.5</AvaloniaVersion>
        <!-- Avalonia 12 flips this default to true, which would require x:DataType on the
             tracker ControlTemplates in Themes/Default.axaml ({Binding Position} etc.).
             Pinning it false keeps the vendored source a minimal diff from upstream master,
             matching what the app library itself does (Daqifi.Avalonia.csproj). -->
        <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
        <OxyPlotCoreVersion>2.2.0</OxyPlotCoreVersion>
    </PropertyGroup>
</Project>
