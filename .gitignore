# dotnet
bin/
obj/
*.user
*.suo
.vs/
artifacts/
# `dotnet test --logger trx` and every IDE test runner drop results here.
TestResults/

# portomatic working state — ALL of it, local only.
#
# map/, plans/, suites/ and sync_state.yaml used to be committed; they were
# untracked when this repo was opened to the public. They are the port's working
# notes — a file-by-file correspondence map between this app and the upstream WPF
# app — not part of the shipped application, and they are only meaningful to
# someone running portomatic against two local clones.
#
# KEEP YOUR LOCAL COPY. The `// @port:` markers throughout the source still refer
# to `.portomatic/map/`, and every portomatic command reads this directory. A
# fresh clone will not have it, so it has to be carried over by hand or restored
# from a commit before the untracking.
.portomatic/

# agent tooling (regenerate via portomatic's install-skill-pack.sh)
.claude/
publish*/

# Signing material. The release keystore lives outside the repo and its
# passwords are read from the environment (see the signing block in
# Daqifi.Avalonia.Android.csproj), so nothing here should ever be committed.
# These patterns exist so an accidental copy into the tree cannot be staged:
# an upload key in git history means rotating the key with Play support.
*.jks
*.keystore
*.p12
*.pfx
keystore.properties

# Google Play service-account keys. The upload script (tools/play/publish.py) takes a
# path to one; it belongs outside the repo. A leaked key can publish releases to the
# store under our developer account, so these must never be committed.
play-service-account*.json
service-account*.json
*-play-api-*.json
