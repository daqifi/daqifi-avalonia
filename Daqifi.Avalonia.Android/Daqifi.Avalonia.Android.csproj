<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0-android</TargetFramework>
		<SupportedOSPlatformVersion>21</SupportedOSPlatformVersion>
		<OutputType>Exe</OutputType>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<ApplicationId>com.daqifi.avalonia</ApplicationId>
		<ApplicationVersion>1</ApplicationVersion>
		<ApplicationDisplayVersion>3.3.0</ApplicationDisplayVersion>
		<!-- apk (not aab) while the head is dev-loop only — installable via
		     plain `adb install`; store packaging flips this to aab. -->
		<AndroidPackageFormat>apk</AndroidPackageFormat>
		<!-- The desktop project is WinExe; this head consumes its DLL as a
		     library (NETSDK1150's documented escape). The proper shared-
		     project split is the long-term architecture; this keeps the
		     ported app single-sourced meanwhile. -->
		<ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia.Android" Version="11.3.*" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.*" />
	</ItemGroup>

	<ItemGroup>
		<!-- The whole ported app rides in as a library. Desktop-only
		     transports (System.IO.Ports, System.Management) restore their
		     netstandard fallbacks and throw PlatformNotSupported if touched —
		     mobile is WiFi/TCP only by recorded divergence (DIV-UI-003).
		     UndefineProperties: the managed app dll is platform-neutral —
		     letting the head's android RID flow into its build RID-flavors
		     the obj tree and breaks Avalonia's XamlIl task (AVLN9999). -->
		<ProjectReference Include="..\Daqifi.Avalonia\Daqifi.Avalonia.csproj"
		                  UndefineProperties="RuntimeIdentifier;SelfContained" />
	</ItemGroup>
</Project>
