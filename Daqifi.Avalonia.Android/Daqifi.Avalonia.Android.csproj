<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!-- The API level is pinned in the TFM, not left to the workload default.
		     Play requires a new app to target API 35 today and API 36 from
		     2026-08-31, and targetSdkVersion is derived from this. The bare
		     `net10.0-android` moniker happens to resolve to 36.0 on the current
		     workload, but that is an implicit default that moves when the
		     workload is bumped — pinning makes a drop below Play's floor a
		     build-visible change rather than a rejected upload. -->
		<TargetFramework>net10.0-android36.0</TargetFramework>
		<SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
		<OutputType>Exe</OutputType>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<ApplicationId>com.daqifi.avalonia</ApplicationId>
		<ApplicationVersion>1</ApplicationVersion>
		<ApplicationDisplayVersion>3.3.0</ApplicationDisplayVersion>
		<!-- apk (not aab) while the head is dev-loop only — installable via
		     plain `adb install`; store packaging flips this to aab. -->
		<AndroidPackageFormat>apk</AndroidPackageFormat>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia.Android" Version="12.1.1" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
	</ItemGroup>

	<ItemGroup>
		<!-- The whole ported app rides in as a library. Desktop-only
		     transports (System.IO.Ports, System.Management) restore their
		     netstandard fallbacks and throw PlatformNotSupported if touched —
		     mobile is WiFi/TCP only by recorded divergence (DIV-UI-003).
		     UndefineProperties: the managed app dll is platform-neutral —
		     letting the head's android RID flow into its build RID-flavors
		     the obj tree and breaks Avalonia's XamlIl task (AVLN9999). -->
		<ProjectReference Include="..\Daqifi.Avalonia\Daqifi.Avalonia.csproj"
		                  UndefineProperties="RuntimeIdentifier;SelfContained" />
	</ItemGroup>
</Project>
