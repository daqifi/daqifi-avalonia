<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Render on the platform the desktop app ships on (win-x64 Skia native + fonts). -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <!-- Faithful pixels: Skia backend + headless windowing (no display needed). -->
    <PackageReference Include="Avalonia.Headless" Version="11.3.*" />
    <PackageReference Include="Avalonia.Skia" Version="11.3.*" />
    <!-- ClassicDesktopStyleApplicationLifetime lives here; we use it as the app
         lifetime but never call UsePlatformDetect, so windowing stays headless. -->
    <PackageReference Include="Avalonia.Desktop" Version="11.3.*" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.*" />
    <PackageReference Include="Projektanker.Icons.Avalonia.MaterialDesign" Version="9.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../Daqifi.Avalonia/Daqifi.Avalonia.csproj" />
  </ItemGroup>
</Project>
