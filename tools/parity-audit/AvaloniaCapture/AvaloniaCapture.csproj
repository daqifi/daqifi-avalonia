<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- DELIBERATELY NO RuntimeIdentifier. This used to pin win-x64 — "render on the
         platform the desktop app ships on" — which was true when the only host was WSL
         driving the Windows SDK, and false as soon as the port grew a macOS head. A pinned
         RID does not merely bias the pixels, it makes the harness UNRUNNABLE anywhere else:
         a win-x64 build produces a Windows apphost and win-x64-only native assets, so on an
         Apple-silicon Mac there was no way to capture the app at all and the visual-parity
         gate had zero macOS coverage (#89).

         RID-less is what lets one source tree capture on every desktop host. NuGet still
         lays every package's native assets out under runtimes/<rid>/native in the build
         output, and the host resolves the right one for the machine through deps.json at
         run time — so libSkiaSharp/libHarfBuzzSharp load on macOS, Linux and Windows alike
         from the same `dotnet run`.

         Do NOT "fix" a host by adding -r: an explicit-RID restore rewrites this project's
         packages.lock.json to that single RID and the next CI restore fails NU1004. See the
         long note in Directory.Build.props; run.sh passes no -r for exactly this reason. -->
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <!-- Faithful pixels: Skia backend + headless windowing (no display needed). -->
    <PackageReference Include="Avalonia.Headless" Version="12.1.1" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.1" />
    <PackageReference Include="Avalonia.HarfBuzz" Version="12.1.1" />
    <!-- ClassicDesktopStyleApplicationLifetime lives here; we use it as the app
         lifetime but never call UsePlatformDetect, so windowing stays headless. -->
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="Optris.Icons.Avalonia.MaterialDesign" Version="12.0.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../Daqifi.Avalonia/Daqifi.Avalonia.csproj" />
  </ItemGroup>
</Project>
